.DS_Store
node_modules/
.pnpm-store/

# Local runtime data
job-tracker/data/jobs.db
job-tracker/data/jobs.db-*
job-tracker/data/settings.json
job-tracker/storage/**
!job-tracker/storage/.gitkeep
local/**
!local/.gitkeep

# Local config
.env*
!.env.example
job-tracker/.env*
